{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Win32 Debug",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy", "Bypass",
				"-File", "${workspaceFolder}/scripts/Build-SLDOpenGL.ps1",
				"-Config", "Debug"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$msCompile"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
		}
	]
}
